# Local development credentials match the repository's docker-compose.yml.
# Inside Compose, use postgres instead of localhost as the hostname.
DATABASE_URL="postgresql://atc_user:atc_password@localhost:5432/atc_quiz?schema=public"
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Generate a local secret: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_TTL_SECONDS=3600
LOGIN_RATE_LIMIT=10
# Set to true only behind a known reverse proxy (the Docker nginx), so the client IP comes from X-Forwarded-For.
TRUST_PROXY=false
