generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum QuizStatus {
  DRAFT
  PUBLISHED
}

enum QuizLanguage {
  AR
  EN
}

enum NegativeMarking {
  NONE
  FRACTION
  FIXED
}

/// Who a quiz is for: every student in the assigned classes, or a named list of students.
enum QuizAudience {
  CLASSES
  STUDENTS
}

enum AttemptStatus {
  IN_PROGRESS
  SUBMITTED
  EXPIRED
}

model User {
  id              String        @id @default(uuid()) @db.Uuid
  username        String        @unique @db.VarChar(100)
  name            String        @db.VarChar(200)
  passwordHash    String
  role            Role
  classId         String?       @db.Uuid
  class           Class?        @relation(fields: [classId], references: [id], onDelete: Restrict)
  quizzes         Quiz[]        @relation("QuizOwner")
  attempts        Attempt[]
  quizAssignments QuizStudent[]
  createdAt       DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@index([classId])
}

model Class {
  id       String      @id @default(uuid()) @db.Uuid
  name     String      @unique @db.VarChar(100)
  students User[]
  quizzes  QuizClass[]
}

model Quiz {
  id              String          @id @default(uuid()) @db.Uuid
  teacherId       String          @db.Uuid
  teacher         User            @relation("QuizOwner", fields: [teacherId], references: [id], onDelete: Restrict)
  title           String          @db.VarChar(200)
  description     String?
  language        QuizLanguage    @default(EN)
  durationMinutes Int             @default(20)
  opensAt         DateTime        @db.Timestamptz(3)
  closesAt        DateTime        @db.Timestamptz(3)
  status          QuizStatus      @default(DRAFT)
  negativeMarking NegativeMarking @default(NONE)
  penaltyValue    Decimal         @default(0) @db.Decimal(12, 4)
  audience        QuizAudience    @default(CLASSES)
  classes         QuizClass[]
  students        QuizStudent[]
  questions       Question[]
  attempts        Attempt[]
  createdAt       DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @db.Timestamptz(3)

  @@index([teacherId])
  @@index([status, opensAt, closesAt])
}

model QuizClass {
  quizId  String @db.Uuid
  classId String @db.Uuid
  quiz    Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  class   Class  @relation(fields: [classId], references: [id], onDelete: Restrict)

  @@id([quizId, classId])
  @@index([classId])
}

/// Named students for a quiz whose audience is STUDENTS.
model QuizStudent {
  quizId    String @db.Uuid
  studentId String @db.Uuid
  quiz      Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@id([quizId, studentId])
  @@index([studentId])
}

model Question {
  id      String   @id @default(uuid()) @db.Uuid
  quizId  String   @db.Uuid
  quiz    Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt  String
  points  Decimal  @db.Decimal(12, 4)
  order   Int
  options Option[]
  answers Answer[]

  // Composite identity lets Answer enforce that its question belongs to its quiz.
  @@unique([id, quizId])
  @@unique([quizId, order])
}

model Option {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
  order      Int
  answers    Answer[]

  @@unique([id, questionId])
  @@unique([questionId, order])
}

model Attempt {
  id          String        @id @default(uuid()) @db.Uuid
  quizId      String        @db.Uuid
  studentId   String        @db.Uuid
  quiz        Quiz          @relation(fields: [quizId], references: [id], onDelete: Restrict)
  student     User          @relation(fields: [studentId], references: [id], onDelete: Restrict)
  startedAt   DateTime      @default(now()) @db.Timestamptz(3)
  deadlineAt  DateTime      @db.Timestamptz(3)
  submittedAt DateTime?     @db.Timestamptz(3)
  status      AttemptStatus @default(IN_PROGRESS)
  score       Decimal?      @db.Decimal(20, 8)
  maxScore    Decimal       @db.Decimal(20, 8)
  answers     Answer[]

  @@unique([quizId, studentId])
  @@unique([id, quizId])
  @@index([studentId, startedAt])
}

model Answer {
  attemptId  String   @db.Uuid
  quizId     String   @db.Uuid
  questionId String   @db.Uuid
  optionId   String   @db.Uuid
  attempt    Attempt  @relation(fields: [attemptId, quizId], references: [id, quizId], onDelete: Restrict)
  question   Question @relation(fields: [questionId, quizId], references: [id, quizId], onDelete: Restrict)
  option     Option   @relation(fields: [optionId, questionId], references: [id, questionId], onDelete: Restrict)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@id([attemptId, questionId])
  @@index([questionId, quizId])
  @@index([optionId, questionId])
}
